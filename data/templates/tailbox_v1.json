{
  "id": "tailbox_v1",
  "name": "尾翼盒段 v1（前后梁可调 + 操纵面切口，参数化外形）",
  "description": "P2 翼面类第二个结构族。与机翼盒段同属翼面类（肋 × 长桁），但结构特征不同：前后梁位置由参数给定（不固定在前/后缘），且带操纵面切口。参数驱动外形壳面，铺层不在此定义（铺层作 CAE 属性，ADR-0005）。",
  "parameters": [
    {"name": "span",              "type": "float", "min": 2.0,  "max": 15.0, "default": 5.0,   "unit": "m",   "map": "翼展（半展长）"},
    {"name": "sweep_deg",         "type": "float", "min": 0.0,  "max": 55.0, "default": 32.0,  "unit": "deg", "map": "后掠角"},
    {"name": "c_root",            "type": "float", "min": 0.6,  "max": 5.0,  "default": 1.8,   "unit": "m",   "map": "根弦长"},
    {"name": "c_tip",             "type": "float", "min": 0.2,  "max": 3.0,  "default": 0.9,   "unit": "m",   "map": "尖弦长"},
    {"name": "n_ribs",            "type": "int",   "min": 2,    "max": 30,   "default": 5,     "unit": "",    "map": "翼肋数（含两端的肋）"},
    {"name": "n_stringers",       "type": "int",   "min": 2,    "max": 20,   "default": 5,     "unit": "",    "map": "长桁数（含前后梁）"},
    {"name": "spar_front_frac",   "type": "float", "min": 0.0,  "max": 0.6,  "default": 0.15,  "unit": "",    "map": "前梁位置（弦向分数，0=前缘）"},
    {"name": "spar_rear_frac",    "type": "float", "min": 0.4,  "max": 1.0,  "default": 0.85,  "unit": "",    "map": "后梁位置（弦向分数，1=后缘）"},
    {"name": "cutout_span_frac",  "type": "float", "min": 0.0,  "max": 1.0,  "default": 0.6,   "unit": "",    "map": "操纵面切口展向位置（沿翼展分数）"},
    {"name": "cutout_chord_frac", "type": "float", "min": 0.0,  "max": 1.0,  "default": 0.375, "unit": "",    "map": "操纵面切口弦向位置（前后梁之间的分数）"}
  ],
  "envelope": {
    "note": "参数化包络：在以下约束内改参免重建模板；超出则触发换模板。",
    "constraints": [
      "c_tip < c_root",
      "spar_front_frac < spar_rear_frac",
      "spar_rear_frac - spar_front_frac >= 0.2",
      "span / max(n_ribs - 1, 1) >= 0.3",
      "0.02 <= cutout_span_frac <= 0.98",
      "0.02 <= cutout_chord_frac <= 0.98",
      "abs(cutout_span_frac * (n_ribs - 1) - round(cutout_span_frac * (n_ribs - 1))) > 0.01",
      "abs(cutout_chord_frac * (n_stringers - 1) - round(cutout_chord_frac * (n_stringers - 1))) > 0.01"
    ],
    "note_constraints": "后两条保证操纵面切口不落在翼肋线/长桁线上——否则切口不落在任何自然格内部，不连续格无从标记。"
  },
  "topology": {
    "mode": "wing_surface",
    "note": "尾翼盒段：翼面类布置（等 y 线 = 肋，等 xi 线 = 长桁），但弦向只取前后梁之间那一段，故用 ranges.xi 把参数空间限制在 [spar_front_frac, spar_rear_frac]。",
    "params": {"axial": "span", "n_frames": "n_ribs", "n_stringers": "n_stringers"},
    "ranges": {
      "xi": {"from": "spar_front_frac", "to": "spar_rear_frac"}
    },
    "physical": {"xi_scale": "c_root", "y_unit": "m", "xi_unit": "m"},
    "cutouts": [
      {"name": "elevator_cutout",
       "cy": "cutout_span_frac",
       "cxi": "cutout_chord_frac",
       "note": "升降舵操纵面切口：格内有开口，传力路径中断 -> 不连续格（ADR-0008）"}
    ]
  },
  "checks": {
    "note": "尾翼盒段的默认校核口径（spec 用户故事 18）。尾翼通常为更薄蒙皮、更高剪应力占比，故剪切许用值取更保守值；安全系数沿用型号级 1.5。调用方显式传入的 rules 优先级更高。",
    "criteria": ["tsai_wu", "hashin", "max_stress"],
    "allowables": {"Xt": 1350.0, "Xc": 1100.0, "Yt": 45.0, "Yc": 180.0, "S": 62.0},
    "safety_factor": 1.5
  },
  "template_file": "data/templates/tailbox_v1.CATPart"
}
